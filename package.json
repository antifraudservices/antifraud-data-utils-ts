{
  "name": "antifraud-data-utils-ts",
  "version": "0.1.5",
  "description": "Product-neutral identity verification, evidence and attestation data contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./identity-assurance": {
      "types": "./dist/identity-assurance/index.d.ts",
      "default": "./dist/identity-assurance/index.js"
    },
    "./cryptography": {
      "types": "./dist/cryptography/index.d.ts",
      "default": "./dist/cryptography/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antifraudservices/antifraud-data-utils-ts.git"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "gdc-common-utils-ts": "^2.9.30",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.5.4",
    "pako": "^2.2.0"
  }
}
