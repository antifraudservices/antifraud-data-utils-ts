{
  "name": "antifraud-data-utils-ts",
  "version": "0.2.0",
  "description": "Product-neutral identity, evidence and public organization catalog data contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "default": "./dist/encoding.js"
    },
    "./isco-08": {
      "types": "./dist/isco-08.d.ts",
      "default": "./dist/isco-08.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./identity-assurance": {
      "types": "./dist/identity-assurance/index.d.ts",
      "default": "./dist/identity-assurance/index.js"
    },
    "./cryptography": {
      "types": "./dist/cryptography/index.d.ts",
      "default": "./dist/cryptography/index.js"
    },
    "./organization-service-catalog": {
      "types": "./dist/organization-service-catalog.d.ts",
      "default": "./dist/organization-service-catalog.js"
    },
    "./organization-identity": {
      "types": "./dist/organization-identity.d.ts",
      "default": "./dist/organization-identity.js"
    },
    "./organization-credentials": {
      "types": "./dist/organization-credentials.d.ts",
      "default": "./dist/organization-credentials.js"
    },
    "./service-conversation": {
      "types": "./dist/service-conversation.d.ts",
      "default": "./dist/service-conversation.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antifraudservices/antifraud-data-utils-ts.git"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "gdc-common-utils-ts": "^2.9.30",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.5.4",
    "pako": "^2.2.0"
  }
}
